\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Audited empirical frontier across benchmark studies. \textbf  {(A)}\nobreakspace  {}Nominal confidence vs.\ calibrated candidate budget ratio $B/N$. \textbf  {(B)}\nobreakspace  {}Nominal confidence vs.\ full-universe fallback rates, showing the sharp phase transition to full fallback at 90--95\% confidence. \textbf  {(C)}\nobreakspace  {}Problem scale $N$ vs.\ end-to-end speedup in CFLP, visibly documenting the non-monotonic recovery slowdown at $N=30$ ($0.852\times $) and recovery at $N=50$ ($1.180\times $). \textbf  {(D)}\nobreakspace  {}Certification tolerance $\varepsilon _{\mathrm  {cert}}$ vs.\ perspective E2E speedup, illustrating that continuous relaxation solve overhead prevents wall-clock break-even ($<1.0\times $) across tested scales.}}{19}{figure.1}\protected@file@percent }
\newlabel{fig:empirical_frontier_4panel}{{1}{19}{Audited empirical frontier across benchmark studies. \textbf {(A)}~Nominal confidence vs.\ calibrated candidate budget ratio $B/N$. \textbf {(B)}~Nominal confidence vs.\ full-universe fallback rates, showing the sharp phase transition to full fallback at 90--95\% confidence. \textbf {(C)}~Problem scale $N$ vs.\ end-to-end speedup in CFLP, visibly documenting the non-monotonic recovery slowdown at $N=30$ ($0.852\times $) and recovery at $N=50$ ($1.180\times $). \textbf {(D)}~Certification tolerance $\varepsilon _{\mathrm {cert}}$ vs.\ perspective E2E speedup, illustrating that continuous relaxation solve overhead prevents wall-clock break-even ($<1.0\times $) across tested scales}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Empirical speed--quality--certification frontier on the 2024 real-market test dataset ($N=10, H=3, 51$ weekly decision epochs; data from Table\nobreakspace  {}\ref  {tab:solver}). Fast MarketOnly and ML ranking accelerate solve times ($1.73$--$1.76\times $) at the expense of reference match rate ($70.6\%$). Conversely, Certified Recovery achieves a 100\% reference-objective match rate via full-universe continuous relaxation certificates or systematic ladder fallback, incurring modest runtime overhead ($0.59\times $ speedup).}}{20}{figure.2}\protected@file@percent }
\newlabel{fig:frontier}{{2}{20}{Empirical speed--quality--certification frontier on the 2024 real-market test dataset ($N=10, H=3, 51$ weekly decision epochs; data from Table~\ref {tab:solver}). Fast MarketOnly and ML ranking accelerate solve times ($1.73$--$1.76\times $) at the expense of reference match rate ($70.6\%$). Conversely, Certified Recovery achieves a 100\% reference-objective match rate via full-universe continuous relaxation certificates or systematic ladder fallback, incurring modest runtime overhead ($0.59\times $ speedup)}{figure.2}{}}
